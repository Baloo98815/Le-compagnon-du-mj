PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# DB_PATH=./data/compagnon_mj.db

# Authentification
# Secret de signature des jetons (obligatoire en production)
JWT_SECRET=changez-moi-par-une-chaine-aleatoire-longue
# Compte MJ créé au premier démarrage (si aucun utilisateur n'existe)
ADMIN_USERNAME=mj
ADMIN_PASSWORD=changeme

# Génération de PNJ assistée par IA (optionnel — écran Admin)
# Sans cette clé, la génération de PNJ retombe automatiquement sur un tirage aléatoire local.
PERPLEXITY_API_KEY=
